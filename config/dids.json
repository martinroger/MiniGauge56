{
  "_schema_guide": {
    "description": "Master DID Dictionary Schema Guide & Example Value Options",
    "keys": {
      "id": "Hexadecimal ECU Data Identifier string (e.g., '0x580C', '0x58F0', '0x4402').",
      "memory_size": "Length in bytes in ECU RAM: 1 (uint8/int8), 2 (uint16/int16), 4 (uint32/int32).",
      "position": "1-indexed byte offset inside raw ECU DID payload (typically 1 or 2).",
      "mul": "Formula multiplier (integer value, default: 1). Formula: ((raw * mul) / div) + add.",
      "div": "Formula divisor (integer value, default: 1). Formula: ((raw * mul) / div) + add.",
      "add": "Formula offset addition (integer value, default: 0).",
      "unit": "Engineering unit display string (e.g., 'RPM', 'Bar', 'kg/h', 'mbar', 'km/h', '°C', 'V', '%')."
    }
  },
