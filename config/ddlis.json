        "local_id": "Hexadecimal Local Identifier byte string (e.g., '0xF0', '0xF1', '0xF2').",
        "name": "Descriptive human-readable name string (e.g., 'engineCore', 'boostAir').",
        "transmission_mode": "ISO 14230-3 transmission mode options: 'single' (0x01 active polling on demand), 'fast' (0x04), 'medium' (0x03), 'slow' (0x02), 'stop' (0x00).",
        "dids": "Array of DID string keys referenced in sequence order from master dids.json."
      }
    }
