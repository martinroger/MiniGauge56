menu "Retro Monochrome LCD Emulator"

    choice LCD_EMULATOR_BOOT_RENDER_MODE
        prompt "Boot Render Mode"
        default LCD_EMULATOR_MODE_RETRO_MONOCHROME
        help
            Select the display rendering mode applied at boot.
            Can be toggled dynamically at runtime via lcd_emulator_set_render_mode().

        config LCD_EMULATOR_MODE_PASSTHROUGH
            bool "Passthrough (Modern Full-Color AMOLED)"

        config LCD_EMULATOR_MODE_RETRO_MONOCHROME
            bool "Retro Dot-Matrix LCD (Standard)"

        config LCD_EMULATOR_MODE_RETRO_INVERTED
            bool "Retro Dot-Matrix LCD (Inverted / Negative)"

        config LCD_EMULATOR_MODE_GRAYSCALE_4BIT
            bool "Retro Dot-Matrix LCD (4-bit Grayscale / 16 shades)"

        config LCD_EMULATOR_MODE_GRAYSCALE_8BIT
            bool "Retro Dot-Matrix LCD (8-bit Grayscale / 256 shades)"
    endchoice

    choice LCD_EMULATOR_GRAYSCALE_SHADING_STYLE
        prompt "Default Grayscale Shading Style"
        default LCD_EMULATOR_SHADING_PALETTE_TINTED
        help
            Select whether grayscale shading is tinted by the active palette (interpolating
            from inactive to active dot color) or renders as neutral monochrome gray.

        config LCD_EMULATOR_SHADING_PALETTE_TINTED
            bool "Palette-Tinted (Interpolates between inactive and active dot colors)"

        config LCD_EMULATOR_SHADING_NEUTRAL_GRAY
            bool "Neutral Gray (True monochrome R=G=B)"
    endchoice

    config LCD_EMULATOR_INVERT_OUTPUT
        bool "Invert LCD dot output polarity (Negative display)"
        default n
        help
            Invert the dot matrix state so that active elements become inactive and vice-versa.
            This produces a negative LCD / inverted display appearance.

    config LCD_EMULATOR_DARK_THEME_INPUT
        bool "Source UI has dark theme (AMOLED / black background with bright text)"
        default y
        help
            Enable if the source UI is designed for dark theme / AMOLED (black background,
            bright white/colored text and gauges). Bright elements become active LCD dots,
            and the black background becomes the inactive substrate. Disable if source UI
            has a white background with dark ink.

    config LCD_EMULATOR_DEFAULT_CELL_SIZE
        int "Default dot pitch (cell size in physical pixels)"
        default 4
        range 2 8
        help
            Physical pixel width and height of each simulated LCD dot matrix element.
            For example:
              - 3 pixels on a 466x466 screen corresponds to a 155x155 LCD matrix.
              - 4 pixels on a 466x466 screen corresponds to a 116x116 LCD matrix.

    config LCD_EMULATOR_DEFAULT_GAP_SIZE
        int "Default inactive gap width (pixels)"
        default 1
        range 0 3
        help
            Physical pixel gap between adjacent LCD dot elements simulating the inactive substrate grid.

    config LCD_EMULATOR_DEFAULT_THRESHOLD
        int "Default luminance threshold (0..255)"
        default 100
        range 0 255
        help
            Luminance threshold separating active LCD ink from the substrate.
            For anti-aliased fonts on AMOLED (dark theme), 90..120 gives crisp, legible strokes.

    choice LCD_EMULATOR_DEFAULT_PALETTE
        prompt "Default LCD Color Palette"
        default LCD_EMULATOR_PALETTE_OLIVE
        help
            Select the default color palette preset applied at boot.

        config LCD_EMULATOR_PALETTE_OLIVE
            bool "Classic Olive STN (Game Boy / Nokia 5110)"

        config LCD_EMULATOR_PALETTE_CASIO
            bool "Casio Reflective Grey / Silver"

        config LCD_EMULATOR_PALETTE_AMBER
            bool "Industrial Amber Backlit"

        config LCD_EMULATOR_PALETTE_CYAN
            bool "Nokia Cyan EL Backlit"
    endchoice

    config LCD_EMULATOR_EXPAND_TO_RGB565
        bool "Expand 8-bit framebuffer to 16-bit RGB565 for display hardware"
        default y if LV_COLOR_DEPTH_8
        default n
        help
            When LV_COLOR_DEPTH is 8 (L8 grayscale), LVGL renders in an 8-bit draw buffer.
            If the physical display controller (e.g. CO5300 AMOLED) requires 16-bit RGB565,
            enable this option to expand the 8-bit buffer to RGB565 before forwarding
            to the original display flush callback.

    # Backward compatibility alias
    config LCD_EMULATOR_ENABLE_AT_BOOT
        bool
        default y if !LCD_EMULATOR_MODE_PASSTHROUGH
        default n if LCD_EMULATOR_MODE_PASSTHROUGH

endmenu
