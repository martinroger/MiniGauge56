    choice RACEBOX_CAN_RATE_UTC_TIME
        prompt "Message 0x605 (UTC Date & Time) Broadcast Rate"
        default RACEBOX_CAN_RATE_UTC_TIME_25HZ
        help
            Transmission frequency for RB_UTC_TIME message.

        config RACEBOX_CAN_RATE_UTC_TIME_25HZ
            bool "25 Hz (Every frame)"
        config RACEBOX_CAN_RATE_UTC_TIME_10HZ
            bool "10 Hz"
        config RACEBOX_CAN_RATE_UTC_TIME_5HZ
            bool "5 Hz"
        config RACEBOX_CAN_RATE_UTC_TIME_1HZ
